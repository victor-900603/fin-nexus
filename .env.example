# MinerU 解析設定
FINRAG_MINERU_MODE=remote
FINRAG_MINERU_TIER=basic
FINRAG_MINERU_API_KEY=
FINRAG_MINERU_REMOTE_URL=

# 資料根目錄
FINRAG_DATA_DIR=data

# 日誌等級
FINRAG_LOG_LEVEL=INFO

# Qdrant 連線設定
FINRAG_QDRANT_URL=http://localhost:6333
FINRAG_QDRANT_API_KEY=
FINRAG_QDRANT_TIMEOUT=10

# 生成層 LLM 設定（OpenAI 相容端點）
FINRAG_LLM_BASE_URL=http://localhost:8000/v1
FINRAG_LLM_API_KEY=
FINRAG_LLM_MODEL=
FINRAG_LLM_TIMEOUT=60
FINRAG_LLM_MAX_TOKENS=1024
FINRAG_LLM_TEMPERATURE=0
FINRAG_LLM_MIN_SCORE=0
