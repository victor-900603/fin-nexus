# MinerU 解析設定
FIN_NEXUS_MINERU_MODE=remote
FIN_NEXUS_MINERU_TIER=basic
FIN_NEXUS_MINERU_API_KEY=
FIN_NEXUS_MINERU_REMOTE_URL=

# 資料根目錄
FIN_NEXUS_DATA_DIR=data

# 日誌等級
FIN_NEXUS_LOG_LEVEL=INFO

# Qdrant 連線設定
FIN_NEXUS_QDRANT_URL=http://localhost:6333
FIN_NEXUS_QDRANT_API_KEY=
FIN_NEXUS_QDRANT_TIMEOUT=10

# 生成層 LLM 設定（OpenAI 相容端點）
FIN_NEXUS_LLM_BASE_URL=http://localhost:8000/v1
FIN_NEXUS_LLM_API_KEY=
FIN_NEXUS_LLM_MODEL=
FIN_NEXUS_LLM_TIMEOUT=60
FIN_NEXUS_LLM_MAX_TOKENS=1024
FIN_NEXUS_LLM_TEMPERATURE=0
FIN_NEXUS_LLM_MIN_SCORE=0
